# IMPORTANT: nothing here runs at boot. The cnss2 / qca_cld3_qca6490 modules are
# loaded by the AERA module loader and then sit idle (the firmware "defers for
# calibration"). When the user turns Wi-Fi on, AERA sets sys.aera.wlan.up=1,
# which fires the block below: bring the driver up on demand and start the real
# wpa_supplicant service. Doing the bring-up on demand instead of during init
# keeps it off the boot-critical path so it can never stall/reboot recovery.

on property:sys.aera.wlan.up=1
    # wpa_supplicant's Android ctrl_iface refuses a non-accessible control dir
    # and crash-loops, so force the socket dir world-accessible (init's
    # restrictive umask would otherwise leave it 0700).
    mkdir /tmp/recovery 0777
    mkdir /tmp/recovery/sockets 0777

    # Ensure the QCA6490 firmware is reachable (modem partition). Harmless if the
    # common init.recovery.qcom.rc already mounted it.
    mount vfat /dev/block/bootdevice/by-name/modem${ro.boot.slot_suffix} /firmware ro

    # Point the direct firmware loader at our config dir (also a ueventd dir).
    write /sys/module/firmware_class/parameters/path /etc/firmware

    # Provide the per-device WLAN MAC from the persist partition (init mkdir is
    # not recursive, so create each level).
    mkdir /etc/firmware/wlan 0755
    mkdir /etc/firmware/wlan/qca_cld 0755
    mkdir /etc/firmware/wlan/qca_cld/qca6490 0755
    mkdir /mnt/wlan_persist 0755
    mount ext4 /dev/block/bootdevice/by-name/persist /mnt/wlan_persist ro
    copy /mnt/wlan_persist/qca6490/wlan_mac.bin /etc/firmware/wlan/qca_cld/qca6490/wlan_mac.bin
    umount /mnt/wlan_persist

    # Assert fs_ready -> cnss2 cold-boots the WPSS, the host driver creates
    # wlan0. Then wait up to 15s for the interface.
    write /sys/kernel/cnss/fs_ready 1
    wait /sys/class/net/wlan0 15

    start wpa_supplicant

    # Reset so the next tap is a fresh 0->1 transition that re-fires this block.
    setprop sys.aera.wlan.up 0

service wpa_supplicant /system/bin/wpa_supplicant -Dnl80211 -iwlan0 -dd -O/tmp/recovery/sockets -c/vendor/etc/wifi/wpa_supplicant.conf
    disabled
    seclabel u:r:recovery:s0
