# IMPORTANT: nothing here runs at boot. The cnss2 / qca_cld3_qca6490 modules are
# loaded by the AERA module loader and sit idle until Wi-Fi is used. When the
# user turns Wi-Fi on, AERA sets sys.aera.wlan.up=1 (see
# Wlan::StartInitSupplicantService), which fires the block below: cold-boot the
# chip, hand it to the host driver and start the real wpa_supplicant service.
# Doing the bring-up on demand instead of during init keeps it off the
# boot-critical path so it can never stall/reboot recovery.

on property:sys.aera.wlan.up=1
    # wpa_supplicant's Android ctrl_iface refuses a non-accessible control dir
    # and crash-loops, so force the socket dir world-accessible (init's
    # restrictive umask would otherwise leave it 0700).
    mkdir /tmp/recovery 0777
    mkdir /tmp/recovery/sockets 0777

    # Ensure the QCA6490 firmware is reachable (modem partition). Harmless if
    # the common init.recovery.qcom.rc already mounted it.
    mount vfat /dev/block/bootdevice/by-name/modem${ro.boot.slot_suffix} /firmware ro

    # Point the direct firmware loader at our config dir (also a ueventd dir).
    write /sys/module/firmware_class/parameters/path /etc/firmware

    # Firmware/MAC scratch dir (init mkdir is not recursive). The AERA backend
    # writes a derived wlan_mac.bin here before the modules load
    # (Wlan::PrepareStableMacFirmware: config roots include
    # /system/etc/firmware/wlan/qca_cld/qca6490, which is /etc/firmware/...),
    # so recovery needs no persist copy. The previous mount/copy/umount dance
    # against /mnt/wlan_persist always failed ("Device or resource busy" -
    # /persist is already mounted - and the copy source was missing).
    mkdir /etc/firmware/wlan 0755
    mkdir /etc/firmware/wlan/qca_cld 0755
    mkdir /etc/firmware/wlan/qca_cld/qca6490 0755

    # Assert fs_ready -> cnss2 cold-boots the WPSS and runs cold-boot
    # calibration (measured ~6.2 s on marble).
    write /sys/kernel/cnss/fs_ready 1

    # Hand the chip to the host driver. After calibration cnss2 powers the
    # firmware back DOWN unless qca_cld3 claims the device, and qca_cld3 only
    # creates wlan0 after its control node /dev/wlan (qcwlanstate cdev) gets
    # "ON". The helper creates the node if ueventd did not and writes the
    # exact 3-byte payload; without it wlan0 never appears and wpa_supplicant
    # exits 255 in a respawn loop.
    start aera-wlan-service

    # wlan0 appears once the mission-mode boot finishes; allow for it.
    wait /sys/class/net/wlan0 30

    start wpa_supplicant

    # Reset so the next tap is a fresh 0->1 transition that re-fires this block.
    setprop sys.aera.wlan.up 0

service wpa_supplicant /system/bin/wpa_supplicant -Dnl80211 -iwlan0 -dd -O/tmp/recovery/sockets -c/vendor/etc/wifi/wpa_supplicant.conf
    disabled
    seclabel u:r:recovery:s0

service aera-wlan-service /system/bin/aera_wlan_enable.sh
    user root
    group root
    oneshot
    disabled
    seclabel u:r:recovery:s0
